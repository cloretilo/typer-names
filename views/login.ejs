<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Access | Typer</title>
    <style>
        body { font-family: -apple-system, sans-serif; background: #050505; color: #fff; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .login-box { background: #111; padding: 40px; border-radius: 8px; border: 1px solid #222; text-align: center; width: 300px; }
        input { width: 90%; padding: 12px; margin: 10px 0; background: #0a0a0a; color: #fff; border: 1px solid #333; border-radius: 4px; }
        input:focus { outline: none; border-color: #0070f3; }
        button { width: 100%; padding: 12px; background: #0070f3; color: #fff; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; margin-top: 10px; }
        button:hover { opacity: 0.9; }
        .error { color: #d32f2f; font-size: 0.9rem; margin-bottom: 15px; }
        .back { display: block; margin-top: 20px; color: #777; text-decoration: none; font-size: 0.9rem; }
        .back:hover { color: #fff; }
    </style>
</head>
<body>

    <div class="login-box">
        <h2>Admin Panel</h2>
        
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
            <input type="text" name="username" placeholder="Username" required autocomplete="off">
            <input type="password" name="password" placeholder="Password" required>
            <button type="submit">Login</button>
        </form>
        
        <a href="/" class="back">&larr; Back to Store</a>
    </div>

</body>
</html>