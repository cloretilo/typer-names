<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel | Typer</title>
    <style>
        :root {
            --bg: #050505;
            --card: #111111;
            --text: #eeeeee;
            --muted: #777777;
            --border: #222222;
            --accent: #0070f3;
            --green: #00c853;
            --orange: #ffab00;
            --red: #d32f2f;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
        }

        .header-bar {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid var(--border);
        }
        h1 { margin: 0; font-size: 1.5rem; letter-spacing: 1px; }
        h1 span { color: var(--accent); }
        .nav-links a { text-decoration: none; margin-left: 20px; font-weight: 600; font-size: 0.9rem; }
        .link-shop { color: var(--accent); }
        .link-logout { color: var(--red); }

        .admin-grid { display: grid; grid-template-columns: 1fr; gap: 30px; max-width: 1200px; margin: auto; }
        @media (min-width: 768px) { .admin-grid { grid-template-columns: 300px 1fr; } }

        .box { background: var(--card); padding: 25px; border-radius: 12px; border: 1px solid var(--border); box-shadow: 0 4px 20px rgba(0,0,0,0.2); }
        .box h3 { margin-top: 0; margin-bottom: 20px; color: var(--muted); text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; }

        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-size: 0.85rem; color: var(--muted); }
        input, select {
            width: 100%; padding: 12px; box-sizing: border-box; background: #0a0a0a;
            border: 1px solid var(--border); border-radius: 6px; color: var(--text);
            font-family: inherit; transition: border-color 0.2s;
        }
        input:focus, select:focus { outline: none; border-color: var(--accent); }
        
        .btn-submit {
            width: 100%; padding: 12px; background: var(--accent); color: white;
            border: none; border-radius: 6px; font-weight: bold; cursor: pointer; transition: opacity 0.2s;
        }
        .btn-submit:hover { opacity: 0.9; }

        .inventory-list { max-height: 70vh; overflow-y: auto; padding-right: 10px; }
        .inventory-list::-webkit-scrollbar { width: 8px; }
        .inventory-list::-webkit-scrollbar-track { background: var(--bg); }
        .inventory-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

        .item-row { display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); padding: 15px; margin-bottom: 10px; border-radius: 8px; border: 1px solid transparent; }
        .item-row:hover { border-color: var(--border); }
        .item-info { flex-grow: 1; }
        .item-handle { font-weight: 700; font-size: 1.1rem; display: block; }
        .item-meta { font-size: 0.85rem; color: var(--muted); }
        .price-tag { color: var(--text); font-weight: bold; margin-right: 10px; font-family: monospace; }

        .item-actions { display: flex; gap: 10px; align-items: center; }
        .action-btn { padding: 8px 12px; border: none; border-radius: 4px; font-size: 0.75rem; font-weight: 700; cursor: pointer; text-transform: uppercase; }
        
        .btn-toggle { background: var(--border); color: var(--muted); transition: 0.2s; }
        .btn-toggle.is-available { background: rgba(0, 200, 83, 0.1); color: var(--green); }
        .btn-toggle.is-sold { background: rgba(255, 171, 0, 0.1); color: var(--orange); }
        .btn-toggle:hover { opacity: 0.8; }

        .btn-delete { background: rgba(211, 47, 47, 0.1); color: var(--red); padding: 8px; }
        .btn-delete:hover { background: var(--red); color: white; }

        .modal-overlay {
            display: none;
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            justify-content: center; align-items: center;
            backdrop-filter: blur(5px);
        }
        .modal-box {
            background: var(--card); border: 1px solid var(--border);
            padding: 30px; border-radius: 12px; width: 320px; text-align: center;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            animation: popIn 0.3s ease-out;
        }
        @keyframes popIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        
        .modal-box h4 { margin: 0 0 10px 0; font-size: 1.2rem; color: var(--text); }
        .modal-box p { color: var(--muted); font-size: 0.95rem; margin-bottom: 25px; }
        .modal-handle-name { color: var(--accent); font-weight: bold; }
        
        .modal-actions { display: flex; gap: 10px; justify-content: center; }
        .btn-modal-cancel { background: var(--border); color: var(--text); padding: 12px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }
        .btn-modal-confirm { background: var(--red); color: white; padding: 12px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }
        .btn-modal-cancel:hover { background: #333; }
        .btn-modal-confirm:hover { background: #b71c1c; }
    </style>
</head>
<body>

    <div class="header-bar">
        <h1>Admin<span>Panel</span></h1>
        <div class="nav-links">
            <a href="/" class="link-shop" target="_blank">View Store &rarr;</a>
            <a href="/logout" class="link-logout">Logout</a>
        </div>
    </div>

    <div class="admin-grid">
        <div class="box">
            <h3>Add New</h3>
            <form action="/admin/add" method="POST">
                <div class="form-group">
                    <label>Handle</label>
                    <input type="text" name="name" placeholder="e.g. vxyz" required autocomplete="off">
                </div>
                <div class="form-group">
                    <label>Price</label>
                    <input type="text" name="price" placeholder="e.g. 450" required autocomplete="off">
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select name="category">
                        <option value="4 Letters (Premium)">4 Letters (Premium)</option>
                        <option value="Repeaters & Patterns">Repeaters & Patterns</option>
                        <option value="Rare & 3 Letters">Rare & 3 Letters</option>
                        <option value="Short & Words">Short & Words</option>
                    </select>
                </div>
                <button type="submit" class="btn-submit">Add to Inventory</button>
            </form>
        </div>

        <div class="box">
            <h3>Inventory (<%= inventory.length %> items)</h3>
            <div class="inventory-list">
                <% inventory.forEach(item => { %>
                    <div class="item-row">
                        <div class="item-info">
                            <span class="item-handle"><%= item.name %></span>
                            <div class="item-meta">
                                <span class="price-tag"><%= item.price %></span>
                                <span><%= item.category %></span>
                            </div>
                        </div>
                        
                        <div class="item-actions">
                            <form action="/admin/toggle/<%= item.id %>" method="POST">
                                <button type="submit" class="action-btn btn-toggle <%= item.status === 'Available' ? 'is-available' : 'is-sold' %>">
                                    <%= item.status %>
                                </button>
                            </form>
                            
                            <form action="/admin/delete/<%= item.id %>" method="POST" onsubmit="openModal(event, '<%= item.name %>', this)">
                                <button type="submit" class="action-btn btn-delete" title="Delete">✕</button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>

    <div id="customModal" class="modal-overlay">
        <div class="modal-box">
            <h4>Delete Handle?</h4>
            <p>You are about to delete <span id="modalTargetName" class="modal-handle-name"></span>. This action cannot be undone.</p>
            <div class="modal-actions">
                <button class="btn-modal-cancel" onclick="closeModal()">Cancel</button>
                <button class="btn-modal-confirm" id="confirmDeleteBtn">Yes, delete</button>
            </div>
        </div>
    </div>

    <script>
        let formToSubmit = null;

        function openModal(event, handleName, formElement) {
            event.preventDefault();
            formToSubmit = formElement;
            document.getElementById('modalTargetName').innerText = handleName;
            document.getElementById('customModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('customModal').style.display = 'none';
            formToSubmit = null;
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (formToSubmit) {
                formToSubmit.submit();
            }
        });

        document.getElementById('customModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
    </script>

</body>
</html>